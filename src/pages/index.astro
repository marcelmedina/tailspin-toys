---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllPublishers, getGames } from '../lib/games';

export const prerender = true;

const rawCategoryFilters = Astro.url.searchParams.getAll('category');
const selectedCategoryIds = rawCategoryFilters
    .map((value) => Number(value))
    .filter((value) => Number.isInteger(value) && value > 0);

const publisherFilterValue = Astro.url.searchParams.get('publisher');
const selectedPublisherId =
    publisherFilterValue !== null && publisherFilterValue !== ''
        ? Number(publisherFilterValue)
        : undefined;

const hasActiveFilters = selectedCategoryIds.length > 0 || selectedPublisherId !== undefined;
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const games = await getGames(getDatabase(), {
    categoryIds: selectedCategoryIds.length > 0 ? selectedCategoryIds : undefined,
    publisherId:
        selectedPublisherId !== undefined && Number.isInteger(selectedPublisherId) ? selectedPublisherId : undefined,
});
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 rounded-xl border border-slate-700 bg-slate-900/50 p-5 shadow-lg">
      <form method="get" class="space-y-5" data-testid="filter-form">
        <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
          <fieldset class="flex-1">
            <legend class="mb-3 text-sm font-medium uppercase tracking-wide text-slate-300">
              Categories
            </legend>
            <div class="flex flex-wrap gap-3" data-testid="category-filter-group">
              {categories.map((category) => (
                <label
                  class="inline-flex items-center gap-2 rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-blue-400 focus-within:ring-2 focus-within:ring-blue-500 focus-within:outline-none"
                  data-testid="category-filter-label"
                >
                  <input
                    type="checkbox"
                    name="category"
                    value={category.id}
                    checked={selectedCategoryIds.includes(category.id)}
                    aria-label={`Filter games by category ${category.name}`}
                    data-testid="category-filter-option"
                    class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-900"
                  />
                  <span>{category.name}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="min-w-0 max-w-xs flex-1">
            <label for="publisher-filter" class="mb-2 block text-sm font-medium uppercase tracking-wide text-slate-300">
              Publisher
            </label>
            <select
              id="publisher-filter"
              name="publisher"
              value={selectedPublisherId ?? ''}
              data-testid="publisher-filter"
              class="w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-slate-100 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              <option value="">All publishers</option>
              {publishers.map((publisher) => (
                <option value={publisher.id} selected={selectedPublisherId === publisher.id}>
                  {publisher.name}
                </option>
              ))}
            </select>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <button
            type="submit"
            class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition-colors hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-900"
            data-testid="apply-filters-button"
          >
            Apply filters
          </button>

          {hasActiveFilters && (
            <a
              href="/"
              class="rounded-lg border border-slate-700 px-4 py-2 font-medium text-slate-200 transition-colors hover:border-slate-500 hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-900"
              data-testid="clear-filters-button"
            >
              Clear filters
            </a>
          )}
        </div>
      </form>
    </div>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <div id="games-grid-wrapper" class:list={[games.length === 0 ? 'hidden' : '']}> 
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      </div>

      <div id="empty-state-wrapper" class:list={[games.length === 0 ? '' : 'hidden']}>
        <EmptyState text="No games match the selected filters." />
      </div>
    </div>
  </div>

  <script is:inline>
    const filterForm = document.querySelector('[data-testid="filter-form"]');
    const gameCards = () => Array.from(document.querySelectorAll('[data-testid="game-card"]'));
    const gamesGridWrapper = document.getElementById('games-grid-wrapper');
    const emptyStateWrapper = document.getElementById('empty-state-wrapper');

    const applyClientFilters = () => {
      if (!filterForm) return;

      const selectedCategories = Array.from(
        filterForm.querySelectorAll('input[name="category"]:checked'),
      ).map((checkbox) => checkbox.value);
      const selectedPublisher = filterForm.querySelector('#publisher-filter')?.value ?? '';

      let visibleCount = 0;

      for (const card of gameCards()) {
        const cardCategoryId = card.dataset.gameCategoryId ?? '';
        const cardPublisherId = card.dataset.gamePublisherId ?? '';
        const matchesCategory =
          selectedCategories.length === 0 || selectedCategories.includes(cardCategoryId);
        const matchesPublisher =
          selectedPublisher === '' || selectedPublisher === cardPublisherId;
        const shouldShow = matchesCategory && matchesPublisher;

        card.hidden = !shouldShow;
        if (shouldShow) visibleCount += 1;
      }

      if (gamesGridWrapper) {
        gamesGridWrapper.classList.toggle('hidden', visibleCount === 0);
      }
      if (emptyStateWrapper) {
        emptyStateWrapper.classList.toggle('hidden', visibleCount > 0);
      }

      const params = new URLSearchParams();
      selectedCategories.forEach((categoryId) => params.append('category', categoryId));
      if (selectedPublisher) params.set('publisher', selectedPublisher);

      const nextUrl = `${window.location.pathname}${params.toString() ? `?${params.toString()}` : ''}`;
      window.history.replaceState({}, '', nextUrl);
    };

    if (filterForm) {
      filterForm.addEventListener('submit', (event) => {
        event.preventDefault();
        applyClientFilters();
      });

      filterForm.addEventListener('change', () => {
        applyClientFilters();
      });

      applyClientFilters();
    }
  </script>
</Layout>
